#!/bin/bash
# contorch installer — thin shim served at https://contorch.com/install
# The canonical, reviewable script lives in the context-orchestrator repo:
#   https://github.com/contorch/context-orchestrator/blob/main/bootstrap.sh
#
# Fetch first, then run — `exec bash -c "$(curl …)"` would turn a failed
# download into `bash -c ""`, which exits 0 and installs nothing.
set -euo pipefail
url="https://raw.githubusercontent.com/contorch/context-orchestrator/main/bootstrap.sh"
script="$(curl -fsSL "$url")" || { echo "contorch: could not download $url (curl exit $?)" >&2; exit 1; }
[ -n "$script" ] || { echo "contorch: empty download from $url" >&2; exit 1; }
exec /bin/bash -c "$script"
